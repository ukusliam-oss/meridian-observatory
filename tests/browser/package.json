{
  "name": "meridian-browser-tests",
  "private": true,
  "type": "module",
  "description": "Browser and visual-regression tests for Meridian Observatory (M-003A). Kept apart from the site's own package so `npm run check` and its CI job are unchanged.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "playwright test",
    "test:functional": "playwright test --project=functional",
    "test:visual": "playwright test --project=visual",
    "update": "playwright test --project=visual --update-snapshots",
    "report": "playwright show-report .cache/playwright-report",
    "serve": "node server.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
