{
  "name": "meridian",
  "private": true,
  "type": "module",
  "description": "IGCSE Individuals & Societies revision site — History 0470, Economics 0455, Geography 0460",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dots": "node tools/build-dots.mjs 18000",
    "build": "npm run dots && esbuild src/globe.js --bundle --minify --format=esm --target=es2020 --outfile=assets/js/globe.js",
    "maps": "node tools/build-maps.mjs",
    "world": "esbuild src/world/engine.js --bundle --minify --format=esm --target=es2020 --outfile=assets/js/world.js && esbuild src/world/paint-worker.js --bundle --minify --format=esm --target=es2020 --outfile=assets/js/world-paint.js",
    "serve": "python3 -m http.server 5183",
    "check": "node tools/check.mjs"
  },
  "devDependencies": {
    "d3-geo": "3.1.1",
    "esbuild": "0.28.2",
    "geotiff": "2.1.3",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "polygon-clipping": "0.15.7",
    "shapefile": "0.6.6",
    "three": "0.186.1",
    "topojson-client": "3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "world-atlas": "2.0.2"
  }
}
