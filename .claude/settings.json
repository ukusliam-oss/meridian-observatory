{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push --set-upstream origin main:*)",
      "Bash(git push origin :main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --all:*)",
      "Bash(git push origin --delete:*)",
      "Bash(rtk git push)",
      "Bash(rtk git push origin main:*)",
      "Bash(rtk git push --force:*)",
      "Bash(rtk git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X PUT repos/ukusliam-oss/meridian-observatory/pages:*)",
      "Bash(gh api -X POST repos/ukusliam-oss/meridian-observatory/pages:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api -X DELETE repos/ukusliam-oss/meridian-observatory/branches/main/protection:*)",
      "Edit(../meridian/**)",
      "Write(../meridian/**)"
    ]
  }
}
